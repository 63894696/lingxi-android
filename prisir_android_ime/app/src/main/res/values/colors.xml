<?xml version="1.0" encoding="utf-8"?>
<!--
  键盘视觉 token —— 2026-11-23：B 玉石通润（实色仿半透，无毛玻璃 blur）。
  灵感：青白玉 / 通润高光；底浅绿灰，键面奶白玉，功能键略深一档玉色。
  旧版 Soft White 设计稿见 design/keyboard_design.png（可回滚对照）。
-->
<resources>
    <!-- 键盘底：淡青灰（透过半透明键面可见） -->
    <color name="kb_bg">#FFDDE8E1</color>
    <!-- 字母键：半透乳白玉（约 78% 不透明） -->
    <color name="kb_key">#C8F7FBF8</color>
    <!-- 功能键：稍深半透青玉 -->
    <color name="kb_key_func">#B8D0DDD4</color>
    <!-- 字母键按压 -->
    <color name="kb_key_pressed">#D0C0D4C8</color>
    <!-- 功能键按压 -->
    <color name="kb_key_pressed_func">#D0A8C0B4</color>
    <color name="kb_text">#FF24332C</color>
    <color name="kb_text_func">#FF5A6B62</color>
    <!-- 强调：青绿玉调（回车/拼音/译） -->
    <color name="kb_accent">#FF2F8F78</color>
    <color name="cand_bg">#E8F3F7F4</color>
    <color name="kb_sep">#FFC8D6CE</color>
    <!-- 近阴影（接触面） -->
    <color name="kb_shadow">#40253A30</color>
    <!-- 远阴影（抬起高度感） -->
    <color name="kb_shadow_far">#1A253A30</color>
    <color name="kb_tool_bg">#B8DCE8E1</color>
    <color name="kb_translate_bg">#C0D5EBE3</color>
    <color name="kb_pinyin_capsule">#C0D5EBE3</color>
    <color name="kb_accent_fill">#402F8F78</color>
    <!-- 键面顶部通润高光（减弱，避免胶囊键底边白圈） -->
    <color name="kb_key_gloss_top">#55FFFFFF</color>
    <color name="kb_key_gloss_bot">#00FFFFFF</color>

    <!-- ── 设置页 ────────────────────── -->
    <color name="page_bg">#FFF2F6F3</color>
    <color name="card_bg">#FFFFFFFF</color>
    <color name="card_stroke">#FFD8E4DC</color>
    <color name="text_primary">#FF1F2A24</color>
    <color name="text_secondary">#FF5A6B62</color>
    <color name="accent_pressed">#FF267A66</color>
    <color name="status_green">#FF189048</color>
</resources>
